# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.kpjvcbzjziiyalogkgfc:3137439004Bc@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.kpjvcbzjziiyalogkgfc:3137439004Bc@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Puerto del servidor (Render lo asigna automáticamente vía process.env.PORT)
PORT=3000

# URL pública donde queda desplegado el FRONTEND (Angular en Vercel/Netlify)
# Se usa para construir el link "Responder esta solicitud" en los correos.
FRONTEND_URL="https://tu-frontend.vercel.app"

# JWT para autenticación de asesores/directores
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# ---- Envío de correo (SMTP) ----
# Opción recomendada: una cuenta de Gmail de la oficina con una "contraseña de aplicación"
# (Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="bayron.castellanos@utp.edu.co"
SMTP_PASS="1004776346Bc*"
SMTP_FROM="Agencia de Posgrados UTP <bayron.castellanos>"

# ---- Configuración de negocio (equivalente a las constantes del Codigo.gs) ----
CC_DIRECTOR_POSGRADOS="jhguerre@utp.edu.co"
CC_VICERRECTORIA_ACADEMICA="warenas@utp.edu.co"
NOMBRE_AGENCIA="Agencia de Posgrados UTP"

# Secreto compartido para que el cron externo (o node-cron interno) dispare las alertas SLA
CRON_SECRET="otra-clave-aleatoria-para-proteger-/api/alerts/run"
